# Scoutflo AI Readiness configuration
# Copy to ~/.scoutflo/toolkit.yaml and fill in your targets.
#
# Rules:
# - Hosts, orgs, and names go here in plain text.
# - Secrets NEVER go in this file. Every *_env field names an environment
#   variable that holds the secret. Put each secret in ~/.scoutflo/env (the file
#   every skill reads) via /scoutflo:connect or scoutflo_addsecret <VAR>; a plain
#   shell export is invisible to the plugin process.
# - Delete the blocks for integrations you do not use.
# - Multiple targets of the same integration IN ONE environment: make the block a
#   YAML LIST, where each item is the same mapping PLUS a required `label:` (a
#   slug: lowercase letters/digits/hyphens, unique within the block). The audit
#   runs once per target and writes each to <integration>/<label>/<date>/. A plain
#   single block (no list) is unchanged and writes the flat <integration>/<date>/.
#   Some check steps read one token per tool by its default name (PagerDuty,
#   Datadog, ELK, Grafana, Groundcover, JSM, Zenduty, Sentry, GitHub, the
#   DigitalOcean cost and map steps, LGTM stacks with their own *_token_env): on a
#   list whose targets each name their own token variable, those steps stop and
#   ask you to run each target from a config of its own, with the tool as a single
#   block and SCOUTFLO_CONFIG and SCOUTFLO_AUDIT_DIR set for that target.
#   Example — three HyperDX instances and two Azure subscriptions in one env:
#     clickstack:
#       - label: hdx-eu
#         hyperdx_url: https://hdx-eu:8080
#         hyperdx_api_key_env: HDX_EU_KEY        # Personal API Access Key (not the ingestion key)
#       - label: hdx-us
#         hyperdx_url: https://hdx-us:8080
#         hyperdx_api_key_env: HDX_US_KEY
#     azure:
#       - label: prod-core
#         subscription_id: 0000-0000-0000-0001
#       - label: prod-data
#         subscription_id: 0000-0000-0000-0002
#   (For a DIFFERENT environment — prod vs staging — use a separate file, e.g.
#   toolkit-prod.yaml / toolkit-staging.yaml, and pick it with SCOUTFLO_CONFIG.)

# reports_dir: where all reports and runtime data are written (findings.json,
#   report.md, history.jsonl, topology.md, topology-export.json, exemptions.yaml,
#   raw dumps, large-path run state).
#
#   IMPORTANT — what actually moves the location is the SCOUTFLO_AUDIT_DIR
#   environment variable, because every skill command runs in a fresh shell and
#   only an exported env var threads through them all. The effective location is:
#     SCOUTFLO_AUDIT_DIR if exported, else ./scoutflo-audits (relative to the
#     directory you launch Claude Code from).
#
#   This reports_dir key is a CONVENIENCE, not a second live tier: `doctor` and
#   `start` read it only to print the exact `export SCOUTFLO_AUDIT_DIR=...` line
#   for you to add to your shell profile (and to ~/.scoutflo/env for scheduled
#   runs), and they warn if reports_dir is set but that export is not yet in
#   effect. Setting reports_dir alone does NOT move where reports land.
#
#   Why bother: on the default, a run from a different folder starts a fresh,
#   empty history (no delta; your topology map / exemptions won't be found).
#   For one durable estate history regardless of launch folder, export
#   SCOUTFLO_AUDIT_DIR to a fixed absolute path and set reports_dir to match so
#   doctor keeps surfacing the export line.
#
# reports_dir: ~/scoutflo-estate/audits   # absolute path recommended; a leading ~ is expanded to your home directory

grafana:
  url: https://grafana.example.com          # your Grafana base URL
  token_env: GRAFANA_TOKEN                  # service-account token (read-only for audits)
  tier: read-only                           # read-only | elevated; audits require read-only

sentry:
  host: sentry.io                           # sentry.io, us.sentry.io, de.sentry.io, or self-hosted host
  org: your-org-slug
  token_env: SENTRY_TOKEN                   # org auth token (read-only scopes for audits)
  tier: read-only

pagerduty:
  token_env: PAGERDUTY_TOKEN                # General Access REST API key (read-only for audits)
  tier: read-only
  # region: us                              # us (api.pagerduty.com) or eu (api.eu.pagerduty.com); default us

datadog:
  site: datadoghq.com                       # your Datadog site; API host is api.<site>
  api_key_env: DATADOG_API_KEY              # org-level API key
  app_key_env: DATADOG_APP_KEY              # user-bound Application key (scoped read-only for audits)
  tier: read-only
  # cost_checks: true                       # optional, default true; set false to skip the cost section

elk:
  kibana_url: https://kibana.example.com    # Kibana base URL (NOT Elasticsearch); alerting rules live in Kibana
  token_env: KIBANA_API_KEY                 # Elasticsearch API key (works on both ES and Kibana APIs)
  tier: read-only
  # spaces: [default]                       # OPTIONAL: omit to audit ALL Kibana spaces the key can see
                                            # (auto-discovered via GET /api/spaces/space); list ids to restrict.
                                            # Discovery is complete only if the key has Read at spaces:["*"].

jsm:
  site: your-site.atlassian.net             # your Atlassian site host (used to discover cloud_id)
  email_env: JSM_EMAIL                      # env var holding the Atlassian account email (Basic-auth username)
  token_env: JSM_API_TOKEN                  # env var holding the Atlassian API token (Basic-auth password)
  tier: read-only
  # cloud_id: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # optional UUID; skip site-based discovery if you already know it
  # teams: [team-id-a, team-id-b]           # JSM Operations team IDs to audit (policies/heartbeats are team-scoped); omit to discover from /v1/teams

zenduty:
  token_env: ZENDUTY_TOKEN                  # env var holding the Zenduty (Xurrent IMR) API key; sent as "Authorization: Token <key>"
  tier: read-only                           # NOTE: Zenduty has no read-only key scope; read-only is by GET-only use. Prefer a Bot Token (Beta).
  # teams: [team-unique-id-a]               # Zenduty team unique_ids to audit; omit to discover from /api/account/teams/

groundcover:
  token_env: GROUNDCOVER_API_KEY            # env var holding the API key; sent as "Authorization: Bearer <key>"
  tier: read-only                           # bind the key to a Viewer-role service account for a true read-only tier
  # backend_id: your-backend                # required only for multi-backend accounts; sent as the X-Backend-Id header
  # api_url: https://api.groundcover.com    # override the API base if your deployment uses a different host

lgtm:
  runtime_mode: choose-one                  # REQUIRED: kubernetes | ec2-systemd | docker | external; doctor rejects this placeholder
  # Multiple clusters/environments? Make `lgtm:` a LIST of self-contained stack entries instead
  # of this map — each with its own label, runtime_mode, kubernetes_context, and flat store URLs
  # (loki_url, tempo_url, victoriametrics_url, prometheus_url, ...). audit-lgtm audits each and
  # writes lgtm/<label>/<date>/. See references/providers.md "Multiple clusters / environments".

prometheus:
  url: https://prometheus.example.com
  alertmanager_url: https://alertmanager.example.com
  # token_env: PROM_TOKEN                   # optional, if endpoints require auth
  # basic_user_env: PROM_BASIC_USER          # optional pair for basic-auth-fronted endpoints (covers alertmanager_url/vmalert_url reads too)
  # basic_pass_env: PROM_BASIC_PASS          # when both are set, basic auth overrides the bearer token

clickstack:
  clickhouse_url: https://your-clickhouse-host:8123  # ClickHouse HTTP endpoint
  clickhouse_user: scoutflo_ro              # read-only user: SELECT on the telemetry DB + system.*
  clickhouse_password_env: CH_KEY           # env var holding that read-only user's password
  hyperdx_url: https://your-hyperdx-host:8080  # HyperDX app/UI URL (or the API-server port if exposed)
  hyperdx_api_key_env: HDX_API_KEY          # Personal API Access Key (per-user), NOT the ingestion key
  tier: read-only                           # ClickHouse RO user + HyperDX key are both read-only
  # hyperdx_email_env: HDX_EMAIL            # OPTIONAL legacy fallback (only if no Personal API Access Key):
  # hyperdx_password_env: HDX_PASSWORD      # a real login the audit reads via a session cookie

signoz:
  url: https://your-signoz-host             # SigNoz base URL
  api_key_env: SIGNOZ_API_KEY               # Service Account token, read-only signoz-viewer role
  tier: read-only                           # read scopes only; the audit is GET-only
  # clickhouse_url: https://your-signoz-clickhouse-host:8123  # OPTIONAL: deep ClickHouse backend lane (part counts, disk, TTL)
  # clickhouse_user: scoutflo_ro            # read-only user: SELECT on signoz_* + system.*
  # clickhouse_password_env: SIGNOZ_CH_KEY  # env var for that user's password

newrelic:
  account_id: 1234567                       # the New Relic account to audit (actor.accounts lists what your key can see)
  api_key_env: NEW_RELIC_USER_API_KEY       # a USER API key (NRAK-...), never a license/ingest key
  region: US                                # US (api.newrelic.com) or EU (api.eu.newrelic.com); wrong region = diagnosable 403
  tier: read-only                           # NerdGraph query documents only; the audit sends no mutations

loki:
  # Running VictoriaLogs? Configure it here — audit-lgtm auto-detects LogsQL (no separate block).
  url: https://loki.example.com
  # token_env: LOKI_TOKEN
  # basic_user_env: LOKI_BASIC_USER          # optional pair for basic-auth-fronted endpoints
  # basic_pass_env: LOKI_BASIC_PASS

tempo:
  # Running VictoriaTraces? Configure it here — audit-lgtm auto-detects the Jaeger-shaped API.
  url: https://tempo.example.com
  # token_env: TEMPO_TOKEN
  # basic_user_env: TEMPO_BASIC_USER
  # basic_pass_env: TEMPO_BASIC_PASS

mimir:
  url: https://mimir.example.com
  # token_env: MIMIR_TOKEN
  # basic_user_env: MIMIR_BASIC_USER
  # basic_pass_env: MIMIR_BASIC_PASS
  # tenant_id: your-tenant                  # if multi-tenant

victoriametrics:
  url: https://vm.example.com
  # token_env: VM_TOKEN                     # optional, if endpoints require auth
  # basic_user_env: VM_BASIC_USER            # optional pair for basic-auth-fronted endpoints
  # basic_pass_env: VM_BASIC_PASS
  # vmalert_url: https://vmalert.example.com
  # token_env: VM_TOKEN

digitalocean:
  token_env: DIGITALOCEAN_ACCESS_TOKEN      # doctl honors this natively; read-only scope for audits
  tier: read-only
  # team: personal                         # your team UUID, or personal; required by setup-digitalocean

gcp:
  project: your-project-id                  # GCP project ID the audits target. For several projects make
  #                                         # `gcp:` a labeled LIST and select one per run with
  #                                         # SCOUTFLO_TARGET — cloud spend is per project, so the cost
  #                                         # lane stops rather than choosing an entry for you.
  # region: us-central1                     # example; only needed for regional load balancer checks
  # credentials_env: GOOGLE_APPLICATION_CREDENTIALS  # optional; names the variable holding a service
  #                                         # account key file path. Omit to use your active gcloud login.
  tier: read-only                           # read-only | elevated; audits require read-only
  # --- cost (audit-cost) ---
  # cost_checks: true                       # set false to skip the GCP Recommender cost checks entirely.
  #                                         # When true (default) they need recommender.googleapis.com
  #                                         # enabled + roles/recommender.viewer. Recommender is the ONLY
  #                                         # source of a GCP savings dollar — see connect
  #                                         # references/providers.md "GCP cost prerequisites".
  # billing_bq_dataset: my_billing_export   # BigQuery dataset holding the gcp_billing_export_* tables.
  #                                         # This is the ONLY source of your actual spend by SKU (the
  #                                         # denominator for every savings figure). It is a billing-account
  #                                         # level export that takes a few DAYS to accumulate data, so set
  #                                         # it up well before the audit. Prefer the DETAILED
  #                                         # (resource-level) export: gcp_billing_export_resource_v1_* is
  #                                         # the only flavour carrying per-resource rows, and the only one
  #                                         # GKE cost allocation can attribute per cluster and namespace.
  #                                         # Needs bigquery.googleapis.com, roles/bigquery.jobUser, and
  #                                         # roles/bigquery.dataViewer on the dataset, plus the `bq` CLI.
  #                                         # Omit it and COST-GCP-023 is excluded with that reason —
  #                                         # savings are then a floor, with no total spend to measure
  #                                         # them against.
  # billing_project: my-billing-admin-project
  #                                         # OPTIONAL, and only when the export dataset above lives in a
  #                                         # DIFFERENT project from `project`. A Cloud Billing export is
  #                                         # often written to a dedicated billing/admin project. The audit
  #                                         # addresses the table as <billing_project>.<dataset>.<table> and
  #                                         # runs the query job there, so the BigQuery grants and the
  #                                         # bigquery.googleapis.com API belong to THIS project, while
  #                                         # `project` keeps needing only the usual read-only GCP roles.
  #                                         # Leave it commented out when the export lives in `project` —
  #                                         # a single-project estate needs nothing here.

azure:
  subscription_id: 00000000-0000-0000-0000-000000000000  # subscription the audits target (one per run); auth is `az login`
  # tenant_id: 00000000-0000-0000-0000-000000000000  # optional; pin the Entra tenant only when required
  # region: eastus                          # optional; only for region-scoped checks
  tier: read-only                           # read-only | elevated; audits require read-only

aws:
  account_id: "123456789012"                # AWS account ID the audits target (one account per run)
  region: us-east-1                         # default region; multi-region checks state their own region
  # profile: your-aws-profile                # optional; named profile in ~/.aws/config. Omit to use the
  #                                         # active credential chain (env vars, instance role, SSO).
  # role_env: AWS_ROLE_ARN                   # optional; names the variable holding a role ARN to assume
  tier: read-only                           # read-only | elevated; audits require read-only
  # cost_checks: true                        # optional, default true; set false to skip the Cost & Resource
  #                                         # Optimization section entirely, even if Compute Optimizer/Cost
  #                                         # Explorer/Trusted Advisor permissions are present

github:
  org: your-org                             # GitHub org or user login that owns your repos
  token_env: GITHUB_TOKEN                   # read-only PAT; classic `repo` read scope (private repos)
  #                                         # or fine-grained Contents:Read + Metadata:Read
  tier: read-only                           # read-only | elevated; map-repos requires read-only

kubernetes:
  context: your-kube-context                # kubectl context for cluster checks
  # monitoring_namespace: monitoring
  # --- cost (audit-cost) ---
  # On GKE the audit needs NEITHER of the keys below: node cost comes from the GCP billing
  # export (GKE nodes are Compute Engine VMs) and per-namespace attribution from GKE cost
  # allocation, while the utilisation window comes from Cloud Monitoring — all first-party,
  # all under read access the audit already holds. Set these only to override that.
  # cost_integration_url: http://localhost:9003  # OPTIONAL accelerator. If you ALREADY run Kubecost
  #                                         # (`/model`) or OpenCost (`/allocation`), point this at it and
  #                                         # the audit reads its figures verbatim instead of attributing
  #                                         # cost itself. Never required — and never a reason to install
  #                                         # a new tool just to be audited.
  # prometheus_url: http://localhost:9090   # OPTIONAL override for the utilisation window (default 7d).
  #                                         # Use it for a non-GKE cluster, or when Cloud Monitoring is
  #                                         # disabled on the cluster (some teams switch it off to save
  #                                         # cost). Point it at Prometheus, VictoriaMetrics or Thanos.
  #                                         # With neither this nor Cloud Monitoring the audit falls back
  #                                         # to `kubectl top` — a point-in-time SNAPSHOT, labelled as one
  #                                         # and never presented as sustained.

slack:
  webhook_env: SCOUTFLO_SLACK_WEBHOOK       # incoming-webhook URL for audit briefs
